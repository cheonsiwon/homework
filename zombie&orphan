#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>

void make_zombie(void)                          // -z : zombie 생성
{
    pid_t pid;

    pid = fork();                               // 자식 프로세스 생성

    if (pid < 0) {
        perror("fork");
        exit(1);
    }
    else if (pid == 0) {
        printf("[자식] PID=%d PPID=%d : 바로 종료합니다.\n", getpid(), getppid());
        exit(0);
    }
    else {
        printf("[부모] PID=%d 자식PID=%d : wait() 없이 대기합니다.\n", getpid(), pid);
        printf("       다른 창에서 확인: ps -o pid,ppid,stat,cmd -p %d\n", pid);
        while (1) {
            sleep(1);
        }
    }
}

void make_orphan(void)                          // -o : orphan 생성
{
    pid_t pid;

    pid = fork();                               // 자식 프로세스 생성

    if (pid < 0) {
        perror("fork");
        exit(1);
    }
    else if (pid == 0) {
        // 자식 : 오랫동안 실행
        printf("[자식] PID=%d PPID=%d : 부모 종료 전\n", getpid(), getppid());
        sleep(3);                               
        printf("[자식] PID=%d PPID=%d : 부모 종료 후 (PPID가 바뀜)\n", getpid(), getppid());
        printf("       다른 창에서 확인: ps -o pid,ppid,stat,cmd -p %d\n", getpid());
        sleep(300);                             
        exit(0);
    }
    else {
        printf("[부모] PID=%d 자식PID=%d : 즉시 종료합니다.\n", getpid(), pid);
        exit(0);
    }
}

int main(int argc, char *argv[])
{
    if (argc != 2) {                            // 옵션이 없거나 2개 이상이면 사용법 출력
        printf("사용법: %s -z | -o\n", argv[0]);
        return 1;
    }

    if (strcmp(argv[1], "-z") == 0) {           // 요구사항: -z → zombie
        make_zombie();
    }
    else if (strcmp(argv[1], "-o") == 0) {      // 요구사항: -o → orphan
        make_orphan();
    }
    else {
        printf("알 수 없는 옵션: %s\n", argv[1]);
        printf("사용법: %s -z | -o\n", argv[0]);
        return 1;
    }

    return 0;
}
